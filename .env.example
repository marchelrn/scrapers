# Server
PORT=8080
GIN_MODE=debug
DEBUG_TESTING=true
URL="http://localhost:8080"

# Database (Development / Local)
# Opsi ini digunakan apabila GIN_MODE=debug
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=scrapers
DB_SSLMODE=disable

# Database (Production / Supabase Cloud)
# Opsi DB_URL WAJIB diisi apabila GIN_MODE=release (mengabaikan DB_HOST, DB_USER dsb)
DB_URL="postgresql://postgres.[YOUR_PROJECT_ID]:[YOUR_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require"

# JWT
JWT_SECRET=dev-secret-key-do-not-use-in-production
JWT_EXPIRY=24h