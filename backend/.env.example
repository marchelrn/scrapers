# Server
PORT=8080
GIN_MODE=debug
DEBUG_TESTING=true
URL="http://localhost:8080"

# Database (Development / Local)
# Opsi ini digunakan apabila GIN_MODE=debug dan debug_testing=false
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=scrapers
DB_SSLMODE=disable

# Database (Production / Supabase Cloud)
DB_URL="postgresql://postgres.[YOUR_PROJECT_ID]:[YOUR_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require"

# JWT
JWT_SECRET=dev-secret-key-do-not-use-in-production
JWT_EXPIRY=24h
# ============================================================================
# Kebijakan scraping (worker Python)
# ============================================================================
# Semua variabel di bawah ini opsional -- nilai yang tertulis adalah default yang
# sudah berlaku tanpa perlu diset. Diteruskan otomatis dari proses backend ke
# proses worker. Penyetelan per-domain sebaiknya dilakukan di
# backend/workers/python/domain_policy.json, bukan di sini, karena berkas itu
# mewajibkan pencatatan alasan (_alasan) untuk setiap pengecualian.

# --- Kesopanan permintaan (rate limiting per domain) ------------------------
# Jeda minimum antar permintaan ke domain yang sama, dalam detik. Jeda ini
# dipegang lintas proses melalui berkas kunci, sehingga dua job yang menyasar
# domain sama tetap berbaris. Menurunkan nilai ini adalah penyebab pemblokiran
# nomor satu.
SCRAPER_MIN_INTERVAL_SECONDS=4.0
# Tambahan acak 0..N detik di atas jeda minimum, agar pola permintaan tidak
# terlihat seperti mesin.
SCRAPER_JITTER_SECONDS=2.0
# Ikuti arahan Crawl-delay pada robots.txt bila nilainya lebih besar dari
# SCRAPER_MIN_INTERVAL_SECONDS.
SCRAPER_RESPECT_CRAWL_DELAY=true
# Batas atas satu kali tidur throttle, sebagai jaring pengaman agar job tidak
# menggantung karena Crawl-delay yang tidak wajar.
SCRAPER_MAX_THROTTLE_SLEEP_SECONDS=45

# --- Percobaan ulang dan batas waktu ---------------------------------------
# Jumlah percobaan per permintaan HTTP di dalam worker (bukan jumlah proses).
# Backoff eksponensial berjitter, dan Retry-After dari server selalu diutamakan.
SCRAPER_MAX_ATTEMPTS=3
SCRAPER_TIMEOUT_SECONDS=20.0

# --- Pemutus arus per domain (circuit breaker) -----------------------------
# Setelah N kegagalan berturut-turut yang berasal dari sisi situs (403, 429,
# halaman verifikasi, 5xx), domain tersebut diistirahatkan selama masa
# pendinginan. Tujuannya berhenti mengetuk pintu yang baru saja ditutup.
SCRAPER_CIRCUIT_THRESHOLD=4
SCRAPER_CIRCUIT_COOLDOWN_SECONDS=900

# --- robots.txt ------------------------------------------------------------
# enforce = jalur yang dilarang ditolak sebelum permintaan dikirim (default)
# warn    = tetap diambil, tetapi dicatat sebagai peringatan pada log job
# off     = robots.txt tidak dibaca
# PERUBAHAN PERILAKU: sebelumnya robots.txt tidak pernah dibaca sama sekali.
SCRAPER_ROBOTS_MODE=enforce
SCRAPER_ROBOTS_TTL_SECONDS=21600
SCRAPER_ROBOTS_FAIL_TTL_SECONDS=1800

# --- Identitas (User-Agent) ------------------------------------------------
# identified = bot yang menyebutkan diri, membawa tautan kontak (default)
# browser    = meniru Chrome sepenuhnya, termasuk Sec-CH-UA
# honest     = paling ringkas, tanpa embel-embel peramban
# PERUBAHAN PERILAKU: sebelumnya semua scraper memakai satu User-Agent Chrome
# yang dipatok di kode. Beberapa situs berpelindung WAF mungkin menolak bot yang
# menyebutkan diri; untuk kasus seperti itu setel identity per domain di
# domain_policy.json daripada mengubah default global ini.
SCRAPER_IDENTITY_MODE=identified
SCRAPER_BOT_NAME=BPS-FenomenaBot
SCRAPER_BOT_VERSION=1.0
# Alamat yang dapat dihubungi pengelola situs bila scraping ini mengganggu.
# Boleh berupa URL atau alamat surel; bila surel, header From ikut dikirim.
SCRAPER_BOT_CONTACT=https://www.bps.go.id
SCRAPER_ACCEPT_LANGUAGE=id-ID,id;q=0.9,en-US;q=0.8,en;q=0.7
# Versi mayor Chrome yang dicantumkan pada User-Agent; perlu dinaikkan berkala
# agar tidak terlihat sebagai peramban lama.
SCRAPER_CHROME_MAJOR=131

# --- Peramban (Playwright: teknik css, headless, keyword_find) -------------
SCRAPER_BROWSER_LOCALE=id-ID
SCRAPER_BROWSER_TIMEZONE=Asia/Makassar
SCRAPER_BROWSER_TIMEOUT_MS=30000
# Batas waktu menunggu selector muncul.
SCRAPER_SELECTOR_TIMEOUT_MS=15000
# Jeda setelah halaman dimuat, memberi ruang bagi konten yang dirender JS.
SCRAPER_RENDER_SETTLE_MS=2000
# Batas waktu menunggu halaman verifikasi JavaScript non-interaktif selesai
# sendiri. Tidak ada CAPTCHA yang dipecahkan di sini.
SCRAPER_CHALLENGE_WAIT_MS=8000
# Gambar, media, dan font tidak diunduh: lebih cepat dan jauh lebih ringan bagi
# situs sasaran.
SCRAPER_BLOCK_ASSETS=true
# PERUBAHAN PERILAKU: sebelumnya galat sertifikat TLS selalu diabaikan.
# Mengabaikan galat TLS berarti membuka peluang penyadapan di tengah jalur.
SCRAPER_IGNORE_TLS_ERRORS=false

# --- Cache dan berkas status ----------------------------------------------
# Cache permintaan bersyarat (ETag / If-Modified-Since). Halaman yang tidak
# berubah dijawab 304 oleh server, sehingga hampir tanpa beban.
SCRAPER_HTTP_CACHE=true
SCRAPER_HTTP_CACHE_TTL_SECONDS=604800
SCRAPER_HTTP_CACHE_MAX_BYTES=2097152
# Lokasi status lintas proses (jeda per domain, circuit breaker, cache,
# robots.txt, cookie jar). Default: backend/workers/python/.scraper_state
# SCRAPER_STATE_DIR=/var/lib/bps-scrapers/state
SCRAPER_LOCK_WAIT_TIMEOUT_SECONDS=60
# Berkas kebijakan per domain yang dikelola IPDS.
# SCRAPER_DOMAIN_POLICY_FILE=/etc/bps-scrapers/domain_policy.json

# --- Batas ekstraksi -------------------------------------------------------
# Jumlah artikel Google News yang diambil bersamaan. Jeda per domain sudah
# membariskan penerbit yang sama, jadi menaikkan angka ini hanya menambah beban.
SCRAPER_ARTICLE_WORKERS=3
# Batas waktu untuk menerjemahkan satu tautan Google News menjadi URL penerbit.
# Hasil terjemahan disimpan permanen di berkas status, sehingga eksekusi berikutnya
# atas kata kunci yang sama tidak lagi memerlukan permintaan ke news.google.com.
SCRAPER_GNEWS_DECODE_TIMEOUT=12.0
SCRAPER_MAX_REGEX_MATCHES=5000
SCRAPER_MAX_ELEMENT_TEXT=2500

# ============================================================================
# Pengaman SSRF
# ============================================================================
# Menahan URL yang mengarah ke jaringan internal (localhost, 10.0.0.0/8,
# 169.254.169.254, dan sebagainya), termasuk pada setiap hop pengalihan.
# JANGAN diaktifkan di produksi: operator dapat memakai platform ini untuk
# memindai jaringan internal BPS. Hanya untuk pengujian lokal.
ALLOW_PRIVATE_IP_RESOLUTION=false
